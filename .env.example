# ALMA SOCIAL — les réglages de l'environnement. AUCUNE VALEUR ICI, jamais.
#
# Les valeurs se posent chez l'hébergeur (Clever Cloud → l'application →
# « Environment variables »), ou dans un fichier `.env` local que git ignore.
# Une variable vide vaut une variable absente : la fonction concernée se coupe
# proprement et l'écran Réglages → Santé le dit.
#
# `bancs/banc_secrets.py` vérifie que ce fichier nomme TOUTES les variables que
# le code lit, et qu'aucune n'y porte une valeur.

# ── Les clés (à créer vous-même, voir API-STATUS.md) ──────────────────────
# Le modèle (lecture des photos, textes, tri des commentaires). Sans elle : repli local.
ANTHROPIC_API_KEY=
# L'agrégateur de publication. Sans elle : rien ne part, le bac à sable continue.
UPLOAD_POST_API_KEY=
# Facultatif : le secret qui signe les notifications d'Upload-Post. Inutile en temps normal —
# le bouton Réglages → Santé → « Brancher les notifications » le range lui-même, chiffré.
UPLOAD_POST_WEBHOOK_SECRET=
# L'agrégateur de secours, seulement si SOCIAL_AGREGATEUR=ayrshare.
AYRSHARE_API_KEY=

# ── Ce que vous fabriquez vous-même ───────────────────────────────────────
# Chiffre les jetons des réseaux en base. Une longue phrase aléatoire (40 caractères et plus).
# La perdre = relier à nouveau tous les comptes. OBLIGATOIRE en production.
SOCIAL_CLE_CHIFFREMENT=
# Votre code personnel (6 caractères et plus), lu au PREMIER démarrage seulement.
SOCIAL_CODE_PDG=
# Votre adresse : alertes urgentes et rapport du lundi.
SOCIAL_EMAIL_PDG=

# ── Le courrier (alertes, rapport du lundi) ───────────────────────────────
SMTP_HOST=
# Défaut : 587.
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 1 = rien ne part, les courriels sont seulement gardés en mémoire (bancs, essais).
MAIL_TEST_MODE=

# ── Les adresses ──────────────────────────────────────────────────────────
# L'adresse publique de l'application (les images que l'agrégateur vient chercher).
SOCIAL_URL_PUBLIQUE=
# Facultatif : un domaine court pour les liens tracés (sinon SOCIAL_URL_PUBLIQUE).
SOCIAL_URL_LIENS=

# ── La mesure jusqu'au client (facultatif : sans elles, la porte reste fermée) ──
# Le secret partagé avec le SERVEUR du site d'une marque : il signe chaque demande
# (HMAC-SHA256 du corps, en-tête X-Alma-Signature). Une longue phrase aléatoire.
SOCIAL_CONVERSIONS_SECRET=
# Le jeton que le fournisseur de numéros tracés met dans son webhook (?jeton=…).
SOCIAL_APPELS_SECRET=

# ── La base et les fichiers ───────────────────────────────────────────────
# Production : POSTGRESQL_ADDON_URI est posée d'office par l'add-on PostgreSQL de Clever.
# DATABASE_URL la remplace si besoin. Sans l'une ni l'autre : SQLite (développement seulement).
DATABASE_URL=
POSTGRESQL_ADDON_URI=
# Les photos et leurs déclinaisons : en production, le dossier où est monté le FS Bucket
# (CC_FS_BUCKET=/fichiers:bucket-…, posée avec l'add-on ; alors SOCIAL_FICHIERS=fichiers).
SOCIAL_FICHIERS=
# Garde du montage : si CC_FS_BUCKET est posée et que SOCIAL_FICHIERS n'est pas sur le bucket,
# l'application refuse de démarrer. 1 = la désarmer (décider de risquer des photos perdues).
SOCIAL_DISQUE_SANS_GARDE=
# La base SQLite de développement (défaut : donnees/).
SOCIAL_DONNEES=

# ── Les interrupteurs ─────────────────────────────────────────────────────
# L'horloge (publication, relevés, rapport) tourne dans le processus web. 0 = coupée.
SOCIAL_HORLOGE=
# upload-post (défaut) ou ayrshare.
SOCIAL_AGREGATEUR=
# Les modèles des agents, par niveau (voir alma_social/agents.py). Vides = les défauts
# relus le 05/10/2026 : fort = Opus 5.5, rapide = Sonnet 5.5, tri = Haiku 4.5.
# Se règlent aussi agent par agent dans Réglages, sans redéployer.
SOCIAL_MODELE=
SOCIAL_MODELE_FORT=
SOCIAL_MODELE_RAPIDE=
SOCIAL_MODELE_TRI=
SOCIAL_EFFORT=
# Le plafond de dépense IA du mois, en dollars (défaut 150). Au-delà, chaque agent passe
# sur son repli sans modèle, et une alerte part. Réglable aussi dans Réglages.
SOCIAL_PLAFOND_IA_USD=
# Le nettoyage des objets parasites (« retouche maximale ») : une clé Stability AI, facultative.
# Sans elle, un effacement local (OpenCV) prend le relais pour les petits objets.
SOCIAL_NETTOYAGE_URL=
SOCIAL_NETTOYAGE_CLE=
# 1 = hébergé ailleurs que chez Clever : jamais de code d'essai, jamais de clé de secours.
# (Clever Cloud pose lui-même INSTANCE_ID et APP_ID : rien à faire là-bas.)
SOCIAL_PRODUCTION=

# ── v3 J5 : la relation et la réputation ────────────────────────────────
# La fiche de chaque prospect qualifié, envoyée en JSON à l'outil de votre choix
# (CRM, tableur, Zapier…). Vide : rien ne sort, l'export CSV de la Boîte reste là.
SOCIAL_LEADS_WEBHOOK=
# Facultatif : la fiche est alors signée (en-tête X-Alma-Signature: sha256=…).
SOCIAL_LEADS_WEBHOOK_SECRET=
# Google Maps : position sur une grille et lecture de la fiche (API Places, payante
# à l'usage — décision de Philippe). Vide : aucun appel, relevé à la main possible.
GOOGLE_PLACES_API_KEY=
# Taille de la grille (3 = 3 × 3 points, défaut ; 5 = 5 × 5).
SOCIAL_MAPS_GRILLE=
